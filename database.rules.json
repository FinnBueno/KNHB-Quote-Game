{
  "rules": {
    "global": {
      ".read": true,
      ".write": false
    },
    "availableGames": {
      ".read": true,
      ".write": false
    },
    "gameState": {
      "$gameId": {
        "isGameOver": {
          ".read": true,
          ".write": "auth.uid !== null"
        }
      }
    },
    "participants": {
      "$gameid": {
        ".read": true,
        ".write": "auth.uid !== null"
      }
    },
    "quotes": {
      "$gameid": {
        ".read": true,
        ".write": "auth.uid !== null"
      }
    },
    "updateQuotes": {
      ".read": "auth.uid === 'vw6VpZ4rpSXBka5DkQ5J5j5XPnI3'",
      ".write": "auth.uid === 'vw6VpZ4rpSXBka5DkQ5J5j5XPnI3'"
    },
    "activeQuote": {
      "$gameid": {
        ".read": true,
        ".write": "auth.uid !== null",
        "content": {
          ".read": true,
          ".write": "auth.uid !== null"
        },
        "showAnswer": {
          ".read": true,
          ".write": "auth.uid !== null"
        },
        "votes": {
          ".read": true,
          ".write": true
        }
      }
    }
  }
}
